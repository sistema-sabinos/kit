{
  "permissions": {
    "ask": [
      "Edit(/_contexto/autonomia.md)"
    ],
    "allow": [
      "Bash(node .claude/skills/*)",
      "Bash(node _ferramentas/*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(npm install)",
      "Bash(npm install --prefix .claude/skills/*)",
      "Bash(npm ci)",
      "Bash(npm ci --prefix .claude/skills/*)",
      "Bash(ffmpeg *)",
      "Bash(ffprobe *)",
      "Bash(python .claude/skills/*)",
      "Bash(python3 .claude/skills/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/barrar-perigoso.mjs\""
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/barrar-mcp.mjs\"",
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/auto-sync.mjs\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/aviso-fechamento.mjs\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/aviso-fechamento.mjs\""
          }
        ]
      }
    ]
  }
}
