{
  "permissions": {
    "ask": [
      "Read(./.env)",
      "Read(./.env.*)"
    ],
    "deny": [
      "Read(./secrets/**)",
      "Read(./.secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/barrar-perigoso.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/auto-sync.mjs\""
          }
        ]
      }
    ]
  }
}
